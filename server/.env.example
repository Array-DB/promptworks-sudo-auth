PW_HOST=127.0.0.1
PW_PORT=8787
PW_DB_PATH=./promptworks-auth.sqlite
# REQUIRED. Generate with: openssl rand -base64 48
PW_ADMIN_TOKEN=
# First-time pairing only; installer generates these automatically.
PW_PAIRING_MASTER_HEX=
PW_OFFLINE_HOST_ID=
PW_PAIRING_ID=
PW_HOST_PUBLIC_KEY_PATH=/etc/promptworks-server/host-identity.pub.pem
